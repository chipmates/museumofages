# Every setting the museum and its site read, with what each one does.
# None is a secret, and none is needed: a fresh clone runs `pnpm dev` with
# all of them unset.
#
# They are read from the environment of the command that runs:
#   NA_ASSET_STORE=/path/to/store pnpm dev
# To keep your own set, copy this file to .env (git ignores it), uncomment
# what you need and load it into your shell first:
#   set -a; . ./.env; set +a
# Vite also reads the VITE_NA_ build settings from museum/.env and
# museum/.env.production.
#
# The values shown are the ones the public site uses, or examples.


# ---- The dev server and the checks (in museum/) --------------------------

# The museum's asset store: the pictures, textures and models the records
# name. pnpm build and the full manifest check need the museum's own store.
# Unset: asset-store/ at the repository's root, where
# `node forge/fetch-store.mjs` puts its copy of the public files. With no
# store at all, pnpm dev reads the public site.
# NA_ASSET_STORE=/path/to/asset-store

# The site pnpm dev reads for what the store does not have, GET only.
# Unset: https://museumofages.org. `off`: no network, and a missing file
# answers 404.
# NA_PUBLIC_ORIGIN=off

# A folder of film releases (<release>/film.json) that pnpm dev serves under
# /film/, to play the film offline. Unset: without a store of its own,
# pnpm dev reads the films from the public site.
# NA_FILM_DIR=/path/to/films

# 1: pnpm dev lets the browser keep the store's files for a day, so a reload
# does not fetch them again. Unset: every file is read fresh.
# NA_ASSET_CACHE=1

# The folder of the app's own records. Unset: museum/assets.
# NA_APP_ASSETS=/path/to/assets


# ---- The build (pnpm build in museum/) -----------------------------------

# Where the built app reads the store's files.
# Unset: /na-assets/ on localhost, and on any other host an older media
# address, so set it for every build you deploy.
# VITE_NA_ASSET_BASE=/na/

# The film release a bare wing address (/w/vinci) plays. Unset: a bare wing
# address runs the live engine, and ?film=<release> names a release.
# VITE_NA_FILM_RELEASE=job

# The site's page a wing leads back to, one per wing and language:
# VITE_NA_WING_PAGE_<SLUG>_<LANG>. A path on the same site, never under /w/.
# Unset: the wing leads back to the lobby.
# VITE_NA_WING_PAGE_VINCI_EN=/leonardo-da-vinci/
# VITE_NA_WING_PAGE_VINCI_DE=/de/leonardo-da-vinci/

# Where an address that names no wing leads, per language. Unset: the lobby.
# VITE_NA_SITE_PAGE_EN=/
# VITE_NA_SITE_PAGE_DE=/de/

# 1: the build also carries the swatches, models or parts bench page, for
# the tools in forge/. A public build carries none of them.
# NA_SWATCHES=1
# NA_MODELS=1
# NA_PARTS=1


# ---- The tests (node --test in museum/) ----------------------------------

# A film release folder (with its film.json). Unset: the release's own test
# in forge/film/same-place.test.mjs skips.
# FILM_RELEASE=/path/to/films/job

# A film release's marks file. Set: forge/film/look-kinds.test.mjs also
# checks every mark it carries. Unset: the live wing's own ids only.
# FILM_MARKS=/path/to/marks.json

# The Bright Star Catalogue's file (CDS V/50, catalog). Unset: the full sky
# test in forge/night/real-sky.test.mjs skips.
# BSC5_CATALOG=/path/to/catalog

# A source folder for forge/asset-address-check.mjs to read instead of
# museum/src, for that check's own tests.
# NA_ADDRESS_SRC=/path/to/src


# ---- The tools in museum/forge/ ------------------------------------------

# gltfpack, for forge/encode-library-ktx2.mjs. Unset: tools/bin/gltfpack
# beside the store.
# GLTFPACK=/path/to/gltfpack

# The work folder of forge/encode-library-ktx2.mjs. Unset: the system's
# temporary folder.
# NA_SCRATCH=/path/to/work

# The research folder forge/best-of.mjs reads (or its --from).
# NA_BEST_OF=/path/to/best-of

# The film renderer's lock (forge/film/render-all.mjs): its folder, how
# often a waiting render looks again (in ms, unset 20000), and the name it
# leaves in the lock.
# NA_LOCK_DIR=/path/to/lock
# FILM_LOCK_POLL_MS=20000
# LOCK_OWNER=film-render

# The rigs in forge/ read their own settings (FORGE_, FLICKER_, JOURNEY_,
# MOTION_, SUNSET_ and ZOOM_), each named at the top of its script.


# ---- The website (site/) --------------------------------------------------

# The wing's inventory file. Set: python3 site/_src/build.py compares the
# wing's facts file with it. Unset: the build skips that check and says so.
# MOA_INVENTORY=/path/to/inventory.tsv

# The rest are for the tools that cut the site's pictures and fonts. The
# build needs none of them.

# The folders site/_src/tools/make_images.py and site/pages/make_pictures.py
# cut pictures from: the film's stills, its upright frames, older crops.
# MOA_FILM_STILLS=/path/to/stills
# MOA_FILM_UPRIGHT=/path/to/upright
# MOA_CROPS=/path/to/crops

# The font files site/_src/tools/make_fonts.py cuts from: the full file and
# the cut as it came.
# MOA_FONT_FULL=/path/to/font.ttf
# MOA_FONT_BASE=/path/to/font-cut.woff2

# A headless browser's screenshot tool for site/_src/tools/make_posters.sh.
# MOA_SHOT=/path/to/screenshot-tool
