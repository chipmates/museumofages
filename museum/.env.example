# Copy to .env.local and fill in what the build needs. Every setting is optional.

# The languages the wing offers in its panel, beside English and German, which
# are always on. A language still being written stays out of this list.
VITE_NA_LANGS=en,de

# Where a wing leads back to on the museum's site: one page per wing and
# language (a site path, never another origin). A wing needs both its English
# and German page; another language without a page falls back to English.
# Brazilian Portuguese is written PT_BR.
# VITE_NA_WING_PAGE_VINCI_EN=/leonardo-da-vinci/
# VITE_NA_WING_PAGE_VINCI_DE=/de/leonardo-da-vinci/
# VITE_NA_WING_PAGE_VINCI_FR=/fr/leonard-de-vinci/

# Where an address that names no wing leads: the site's front page per language.
# VITE_NA_SITE_PAGE_EN=/
# VITE_NA_SITE_PAGE_DE=/de/
# VITE_NA_SITE_PAGE_FR=/fr/
