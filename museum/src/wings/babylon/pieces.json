{
 "about": "Every body the Babylon pages build, named to its record row: match is a regular expression on the body's name as the kit's mounts give it (map:<id>, gate:<id>, panel:<id>, life:<id>); the first rule that matches wins. part groups bodies for the coverage map; piece is the row the body's form shows; plan, where given, is the row its foot band shows in the evidence switch (the plan as dug). An empty piece means the record has no row yet; needs names the row it asks for. stops limits a rule to those stops; strips, on a paving, names the row of each of its strips, the middle first (the stone band, its sides, the rest to the walls). The class each row shows comes from record-classes.json through record.ts.",
 "rules": [
  {"match": "^open:northgate-", "part": "the North Gate (open page)", "piece": "bab.northgate.body", "plan": "bab.northgate.plan", "stops": ["open"]},
  {"match": "^open:stretch-", "part": "the walled street north of the North Gate", "piece": "bab.street.north-stretch", "stops": ["open"]},
  {"match": "^open:outwork-embankment$", "part": "the West Fortification's embankment on the river", "piece": "bab.westoutwork", "note": "its top and its batter ours", "stops": ["open"]},
  {"match": "^open:outwork-", "part": "the West Fortification's walls and the space they close", "piece": "bab.westoutwork.body", "plan": "bab.westoutwork", "stops": ["open"]},
  {"match": "^open:bastion-", "part": "the bastions at the dam's south end", "piece": "bab.street.north-bastions", "stops": ["open"]},
  {"match": "^open:dam$", "part": "the dam over the north moat", "piece": "bab.dam.crest", "plan": "bab.dam.plan", "stops": ["open"]},
  {"match": "^open:northwall$", "part": "the North Palace's north wall on its limestone foot", "piece": "bab.northpalace.northwall.brick", "plan": "bab.northpalace.limestone", "note": "its foot to about +0.5 m is the limestone row", "stops": ["open"]},
  {"match": "^open:merlon-", "part": "the north entry's battlements", "piece": "bab.northgate.body", "stops": ["open"]},
  {"match": "^open:house-", "part": "the houses (a type, rebuilt per lot)", "piece": "bab.houses.type", "stops": ["open"]},
  {"match": "^open:palm-(canal|river)", "part": "the date palms of the groves along the river and the canals", "piece": "bab.green.palm.plain", "stops": ["open"]},
  {"match": "^open:palm-city", "part": "the date palms inside the walls", "piece": "bab.green.palm.city", "stops": ["open"]},
  {"match": "^open:palm-outer", "part": "the date palms of the outer city's gardens", "piece": "bab.green.outercity", "stops": ["open"]},
  {"match": "^open:reed", "part": "the reed beds at the canals' edges and in the low ground by the river", "piece": "bab.green.reed", "stops": ["open"]},
  {"match": "^open:bank-tamarisk", "part": "the tamarisks on the canal banks", "piece": "bab.green.tamarisk", "stops": ["open"]},
  {"match": "^open:bank-(poplar|willow)", "part": "the Euphrates poplars and willows on the river and canal banks", "piece": "bab.green.poplar", "stops": ["open"]},
  {"match": "^open:field", "part": "the plain's fields", "piece": "bab.green.field.plain", "surface": true, "stops": ["open"]},
  {"match": "^open:canal", "part": "the plain's canals", "piece": "bab.green.water.channels", "surface": true, "stops": ["open"]},
  {"match": "^open:garden", "part": "the outer city's garden plots and their channels north of the moat (a type, every line ours)", "piece": "bab.green.outercity", "surface": true, "stops": ["open"]},
  {"match": "^open:paving-north$", "part": "the street's paving from the North Gate's court to the dam's south end (the gate's paving material)", "piece": "bab.paving.limestone", "surface": true, "note": "the breccia strips are bab.paving.breccia, the brick outside the stone bab.paving.outer; the street's levels bab.street.north.surface", "stops": ["open"]},
  {"match": "^map:ground$", "part": "the ground", "piece": "bab.ground", "surface": true},
  {"match": "^map:street$", "part": "the street (north of the gate)", "piece": "bab.street.north.surface", "surface": true, "stops": ["1", "2", "3", "open"]},
  {"match": "^map:street$", "part": "the street (south of the gate)", "piece": "bab.street.south-gate", "surface": true, "stops": ["4", "5", "6"]},
  {"match": "^map:street$", "part": "the street over the canal and beyond it, washed away", "piece": "bab.street.washedaway", "surface": true, "note": "over the canal on the king's bridge, its form not known (bab.canalbridge); the stretch beyond washed away for about 150 m", "stops": ["7"]},
  {"match": "^map:street$", "part": "the street (south, to the canal)", "piece": "bab.street.south-paved", "surface": true, "stops": ["8"]},
  {"match": "^map:street$", "part": "the street (by the precinct)", "piece": "bab.street.precinct-east", "surface": true, "stops": ["9", "10"]},
  {"match": "^map:street$", "part": "the street (west to the bridge)", "piece": "bab.street.west-assumed", "surface": true, "stops": ["11", "12", "13", "14"]},
  {"match": "^map:water-euphrates$", "part": "the river's water", "piece": "bab.river.water", "surface": true},
