{
 "about": "Every body the Babylon pages build, named to its record row: match is a regular expression on the body's name as the kit's mounts give it (map:<id>, gate:<id>, panel:<id>, life:<id>); the first rule that matches wins. part groups bodies for the coverage map; piece is the row the body's form shows; plan, where given, is the row its foot band shows in the evidence switch (the plan as dug). An empty piece means the record has no row yet; needs names the row it asks for. stops limits a rule to those stops; strips, on a paving, names the row of each of its strips, the middle first (the stone band, its sides, the rest to the walls). The class each row shows comes from record-classes.json through record.ts.",
 "rules": [
  {"match": "^open:northgate-", "part": "the North Gate (open page)", "piece": "bab.northgate.body", "plan": "bab.northgate.plan", "stops": ["open"]},
  {"match": "^open:stretch-", "part": "the walled street north of the North Gate", "piece": "bab.street.north-stretch", "stops": ["open"]},
  {"match": "^open:outwork-embankment$", "part": "the West Fortification's embankment on the river", "piece": "bab.westoutwork", "note": "its top and its batter ours", "stops": ["open"]},
  {"match": "^open:outwork-", "part": "the West Fortification's walls and the space they close", "piece": "bab.westoutwork.body", "plan": "bab.westoutwork", "stops": ["open"]},
  {"match": "^open:bastion-", "part": "the bastions at the dam's south end", "piece": "bab.street.north-bastions", "stops": ["open"]},
  {"match": "^open:dam$", "part": "the dam over the north moat", "piece": "bab.dam.crest", "plan": "bab.dam.plan", "stops": ["open"]},
  {"match": "^open:northwall$", "part": "the North Palace's north wall on its limestone foot", "piece": "bab.northpalace.northwall.brick", "plan": "bab.northpalace.limestone", "note": "its foot to about +0.5 m is the limestone row", "stops": ["open"]},
  {"match": "^open:merlon-", "part": "the north entry's battlements", "piece": "bab.northgate.body", "stops": ["open"]},
  {"match": "^open:house-", "part": "the houses (a type, rebuilt per lot)", "piece": "bab.houses.type", "stops": ["open"]},
  {"match": "^open:palm-(canal|river)", "part": "the date palms of the groves along the river and the canals", "piece": "bab.green.palm.plain", "stops": ["open"]},
  {"match": "^open:palm-city", "part": "the date palms inside the walls", "piece": "bab.green.palm.city", "stops": ["open"]},
  {"match": "^open:palm-outer", "part": "the date palms of the outer city's gardens", "piece": "bab.green.outercity", "stops": ["open"]},
  {"match": "^open:field", "part": "the plain's fields", "piece": "bab.green.field.plain", "surface": true, "stops": ["open"]},
  {"match": "^open:canal", "part": "the plain's canals", "piece": "bab.green.water.channels", "surface": true, "stops": ["open"]},
  {"match": "^open:garden", "part": "the outer city's garden plots and their channels north of the moat (a type, every line ours)", "piece": "bab.green.outercity", "surface": true, "stops": ["open"]},
  {"match": "^open:paving-north$", "part": "the street's paving from the North Gate's court to the dam's south end (the gate's paving material)", "piece": "bab.paving.limestone", "surface": true, "note": "the breccia strips are bab.paving.breccia, the brick outside the stone bab.paving.outer; the street's levels bab.street.north.surface", "stops": ["open"]},
  {"match": "^map:ground$", "part": "the ground", "piece": "bab.ground", "surface": true},
  {"match": "^map:street$", "part": "the street (north of the gate)", "piece": "bab.street.north.surface", "surface": true, "stops": ["1", "2", "3", "open"]},
  {"match": "^map:street$", "part": "the street (south of the gate)", "piece": "bab.street.south-gate", "surface": true, "stops": ["4", "5", "6"]},
  {"match": "^map:street$", "part": "the street (south, to the canal)", "piece": "bab.street.south-paved", "surface": true, "stops": ["7", "8"]},
  {"match": "^map:street$", "part": "the street (by the precinct)", "piece": "bab.street.precinct-east", "surface": true, "stops": ["9", "10"]},
  {"match": "^map:street$", "part": "the street (west to the bridge)", "piece": "bab.street.west-assumed", "surface": true, "stops": ["11", "12", "13", "14"]},
  {"match": "^map:water-euphrates$", "part": "the river's water", "piece": "bab.river.water", "surface": true},
  {"match": "^map:water-moat-north$", "part": "the north moat's water", "piece": "bab.moat-north.water", "surface": true},
  {"match": "^map:water-moat-east$", "part": "the water east of the dam", "piece": "bab.moat-east.water", "surface": true},
  {"match": "^map:water-canal-north$", "part": "the North Palace canal's water", "piece": "bab.northpalace.canal", "surface": true},
  {"match": "^map:water-canal$", "part": "the canal's water", "piece": "bab.canal.water", "surface": true},
  {"match": "^map:water-(inner-east|west-city)-moat$", "part": "the inner moat's water", "piece": "bab.moats.water", "surface": true},
  {"match": "^map:water-outer-east-moat$", "part": "the outer moat's water", "piece": "bab.moats.water", "surface": true},
  {"match": "^map:house", "part": "the houses (a type)", "piece": "bab.houses.type"},
  {"match": "^map:merkes-", "part": "the Merkes blocks", "piece": "bab.houses.merkes"},
  {"match": "^map:inner-east-karu", "part": "the inner wall's embankment", "piece": "bab.innerwall.embankment.tops", "plan": "bab.innerwall.embankment"},
  {"match": "^map:inner-east-(main|front)-\\d+-t", "part": "the inner wall's towers", "piece": "bab.innerwall.body", "plan": "bab.innerwall.plan"},
  {"match": "^map:inner-east-(main|front)", "part": "the inner wall (east bank)", "piece": "bab.innerwall.body", "plan": "bab.innerwall.plan"},
  {"match": "^map:kasr-wall-[bc]-t", "part": "the inner wall's towers (Kasr)", "piece": "bab.innerwall.body", "plan": "bab.innerwall.plan"},
  {"match": "^map:kasr-wall-[bc]", "part": "the inner wall through the Kasr", "piece": "bab.innerwall.body", "plan": "bab.innerwall.plan"},
  {"match": "^map:west-city-", "part": "the west city's walls", "piece": "bab.innerwall.drawn"},
  {"match": "^map:outer-east-karu", "part": "the outer wall's embankment", "piece": "bab.outerwall.embankment", "plan": "bab.outerwall.plan"},
  {"match": "^map:outer-east-", "part": "the outer east wall", "piece": "bab.outerwall.body", "plan": "bab.outerwall.plan"},
  {"match": "^map:outer-river-wall", "part": "the outer city's river wall", "piece": "bab.outerwall.river"},
  {"match": "^map:gate-front-tower-", "part": "the front gate's towers (map blocks)", "piece": "bab.gate.front.towers.body", "plan": "bab.gate.front.plan"},
  {"match": "^map:gate-front", "part": "the front gate (map blocks)", "piece": "bab.gate.front.body", "plan": "bab.gate.front.plan"},
  {"match": "^map:gate-main-tower-", "part": "the main gate's towers (map blocks)", "piece": "bab.gate.main.towers.body", "plan": "bab.gate.main.plan"},
  {"match": "^map:gate-main", "part": "the main gate (map blocks)", "piece": "bab.gate.main.body", "plan": "bab.gate.main.plan"},
  {"match": "^map:bastion-[we]$", "part": "the forecourt's bastions (map blocks)", "piece": "bab.forecourt.walls.body", "plan": "bab.forecourt.plan"},
  {"match": "^map:north-gate", "part": "the North Gate", "piece": "bab.northgate.body", "plan": "bab.northgate.plan"},
  {"match": "^map:south-palace", "part": "the South Palace", "piece": "bab.southpalace.body", "plan": "bab.southpalace.plan"},
  {"match": "^map:throne-room-facade$", "part": "the throne room's glazed facade", "piece": "bab.throneroom.facade.pattern", "plan": "bab.throneroom.plan"},
  {"match": "^map:throne-room-floor-", "part": "the throne room's floor", "piece": "bab.southpalace.floors", "surface": true},
  {"match": "^map:court-paving$", "part": "the Main Courtyard", "piece": "bab.maincourt.plan", "surface": true},
  {"match": "^map:throne-room", "part": "the throne room", "piece": "bab.throneroom.body", "plan": "bab.throneroom.plan"},
  {"match": "^map:north-palace-terrace$", "part": "the North Palace terrace", "piece": "bab.northpalace.terrace"},
  {"match": "^map:north-palace-main$", "part": "the North Palace", "piece": "bab.northpalace.main.body", "plan": "bab.northpalace.main.plan"},
  {"match": "^map:gardens-edge-", "part": "the edge terraces (the gardens question)", "piece": "bab.gardens.northpalace"},
  {"match": "^map:north-fortification$", "part": "the North Fortification", "piece": "bab.northpalace.northfort"},
  {"match": "^map:north-wall$", "part": "the North Palace's north wall", "piece": "bab.northpalace.northwall.brick", "plan": "bab.northpalace.limestone", "note": "its foot to about +0.5 m is the limestone row"},
  {"match": "^map:west-outwork$", "part": "the West Outwork", "piece": "bab.westoutwork.body", "plan": "bab.westoutwork"},
  {"match": "^map:moat-counter-wall$", "part": "the moat's counter wall", "piece": "bab.moat-north.counterwall"},
  {"match": "^map:dam-wall-", "part": "the dam's walls", "piece": "bab.dam.crest", "plan": "bab.dam.plan"},
  {"match": "^map:ninmah$", "part": "the Ninmah temple", "piece": "bab.ninmah.body", "plan": "bab.ninmah.plan"},
  {"match": "^map:nabu$", "part": "the Nabu temple", "piece": "bab.nabu.body", "plan": "bab.nabu.plan"},
  {"match": "^map:(ishtar-akkad|temple-z|ashratum)$", "part": "the small temples", "piece": "bab.temples.small"},
  {"match": "^map:lion-wall-[we]-t", "part": "the lion walls' towers (map)", "piece": "bab.lionwalls.towers", "plan": "bab.lionwalls.plan"},
  {"match": "^map:lion-wall-[we]", "part": "the lion walls (map)", "piece": "bab.lionwalls.body", "plan": "bab.lionwalls.plan"},
  {"match": "^map:east-fortification", "part": "the East Fortification", "piece": "bab.eastfort.walls"},
  {"match": "^map:(arahtu-quay|river-wall-south)", "part": "the river quay", "piece": "bab.river.quay570"},
  {"match": "^map:gate5-threshold$", "part": "the threshold where Gate 5's inner gate stood", "piece": "bab.precinct.gate5.inner", "plan": "bab.precinct.gate5"},
  {"match": "^map:gate5-street-dug$", "part": "the street before Gate 5 (as dug)", "piece": "bab.street.south-paved", "surface": true},
  {"match": "^map:gate5-street-south$", "part": "the street by the precinct (south of Gate 5)", "piece": "bab.street.precinct-east", "surface": true},
  {"match": "^map:precinct-east-[ns]$", "part": "the precinct's east wall and store blocks at Gate 5", "piece": "bab.precinct.body", "plan": "bab.precinct.gate5"},
  {"match": "^map:precinct-tower-", "part": "the precinct wall's slight towers", "piece": "bab.precinct.body", "plan": "bab.precinct.plan"},
  {"match": "^map:precinct-south-rooms", "part": "the precinct's south rooms", "piece": "bab.precinct.body", "plan": "bab.precinct.southgates"},
  {"match": "^map:precinct-", "part": "the precinct's walls and blocks", "piece": "bab.precinct.body", "plan": "bab.precinct.plan"},
  {"match": "^map:esagila-annex$", "part": "Esagila's annex", "piece": "bab.esagila.body", "plan": "bab.esagila.annex"},
  {"match": "^map:esagila$", "part": "Esagila", "piece": "bab.esagila.body", "plan": "bab.esagila.plan"},
  {"match": "^map:babil$", "part": "the Summer Palace", "piece": "bab.summerpalace"},
  {"match": "^map:altar-gate5$", "part": "the altar before Gate 5", "piece": "bab.precinct.altar"},
  {"match": "^map:bridge-pier-", "part": "the bridge's river piers", "piece": "bab.bridge.piertops", "plan": "bab.bridge.piers"},
  {"match": "^map:bridge-abutment-west", "part": "the bridge's west land pier", "piece": "bab.bridge.landpier.west"},
  {"match": "^map:bridge-abutment-east", "part": "the bridge's east end", "piece": "bab.bridge.landpier.east"},
  {"match": "^map:bridge-deck", "part": "the bridge's roadway", "piece": "bab.bridge.deck"},
  {"match": "^map:tower-stage-1$", "part": "the tower's first stage", "piece": "bab.tower.terrace1", "plan": "bab.tower.base"},
  {"match": "^map:tower-stage-7$", "part": "the temple on the tower", "piece": "bab.tower.top"},
  {"match": "^map:tower-stage-", "part": "the tower's stages 2 to 6", "piece": "bab.tower.stages"},
  {"match": "^map:tower-stair-(east|west)$", "part": "the tower's side stairs", "piece": "bab.tower.stairs.side.rise", "plan": "bab.tower.stairs.side"},
  {"match": "^map:tower-stair", "part": "the tower's middle stair", "piece": "bab.tower.stair.middle.rise", "plan": "bab.tower.stair.middle"},
  {"match": "^map:ramps$", "part": "ramps and stairs (map)", "piece": "bab.ramps.map", "note": "one body holds the bridge's roadway; the tower's three stairs are their own bodies (map:tower-stair-*); split per piece, then each takes its own rows"},
  {"match": "^gate:(front-pier|back-pier|front-side)-", "part": "the front gate's walls", "piece": "bab.gate.front.body", "plan": "bab.gate.front.plan"},
  {"match": "^gate:front-tower-", "part": "the front gate's towers", "piece": "bab.gate.front.towers.body", "plan": "bab.gate.front.plan"},
  {"match": "^gate:m?guard-", "part": "the guard storeys and loopholes", "piece": "bab.gate.towertops"},
  {"match": "^gate:(front-roof|main-roof|beam-)", "part": "the cedar roofs", "piece": "bab.gate.roof"},
  {"match": "^gate:(main-north|main-side|main-south|wing)-", "part": "the main gate's walls", "piece": "bab.gate.main.body", "plan": "bab.gate.main.plan"},
  {"match": "^gate:main-tower-", "part": "the main gate's towers", "piece": "bab.gate.main.towers.body", "plan": "bab.gate.main.plan"},
  {"match": "^gate:court-side-", "part": "the court's side walls", "piece": "bab.gate.main.body", "plan": "bab.gate.court"},
  {"match": "^gate:(front|main)-arch-", "part": "the arches", "piece": "bab.gate.arch"},
  {"match": "^gate:(front-top|main-top)-", "part": "the gate's battlements", "piece": "bab.gate.battlements"},
  {"match": "^gate:(stair-well|stair-cover|postern)", "part": "the forecourt's stairs and postern", "piece": "bab.forecourt.stairs"},
  {"match": "^gate:conn-[we]-top", "part": "the forecourt walls' battlements", "piece": "bab.forecourt.walls.body", "plan": "bab.forecourt.plan"},
  {"match": "^gate:(conn-|bastion-)", "part": "the forecourt's bastions and walls", "piece": "bab.forecourt.walls.body", "plan": "bab.forecourt.plan"},
  {"match": "^gate:(nemet|imgur)-", "part": "the inner walls at the gate", "piece": "bab.innerwall.body", "plan": "bab.innerwall.plan"},
  {"match": "^gate:lion-[we]-\\d+-top$", "part": "the lion walls' battlements", "piece": "bab.lionwalls.battlements"},
  {"match": "^gate:lion-[we]-\\d+$", "part": "the lion walls", "piece": "bab.lionwalls.body", "plan": "bab.lionwalls.plan"},
  {"match": "^gate:skin:lion-", "part": "the lion walls' glazed face (ground, borders, rosette plinth)", "piece": "bab.lions.borders-plinth"},
  {"match": "^gate:skin:(m|reveal-)", "part": "the main gate's glazed faces (ground, bands, plinth)", "piece": "bab.gate.main.body", "plan": "bab.gate.main.plan", "note": "the rosette plinth on these faces is bab.gate.rosetteplinth"},
  {"match": "^gate:skin:", "part": "the front gate's glazed faces (ground, bands, plinth)", "piece": "bab.gate.front.body", "plan": "bab.gate.front.plan", "note": "the rosette plinth on these faces is bab.gate.rosetteplinth"},
  {"match": "^gate:ped-", "part": "the pedestals", "piece": "bab.gate.pedestals.body", "plan": "bab.gate.pedestals"},
  {"match": "^gate:leaf-", "part": "the door leaves", "piece": "bab.gate.doors"},
  {"match": "^gate:paving$", "part": "the paving (limestone and breccia)", "piece": "bab.paving.limestone", "strips": ["bab.paving.limestone", "bab.paving.breccia", "bab.paving.outer"], "surface": true, "note": "the breccia strips are bab.paving.breccia, the brick outside the stone bab.paving.outer"},
  {"match": "^gate:bronze-", "part": "the metal animals", "piece": "bab.gate.metalanimals"},
  {"match": "^panel:lion-", "part": "the lions (glazed panels)", "piece": "bab.lions.frieze"},
  {"match": "^panel:reveal-", "part": "the reveals' animals", "piece": "bab.gate.reveals"},
  {"match": "^panel:m(tower|door)-.*-r[1-4]-", "part": "the main gate's relief rows 1 to 4", "piece": "bab.gate.rows.1-4"},
  {"match": "^panel:m(tower|door)-.*-r[56]-", "part": "the main gate's relief rows 5 and 6", "piece": "bab.gate.rows.5-6"},
  {"match": "^panel:m(tower|door)-.*-r[78]-", "part": "the main gate's relief rows 7 and 8", "piece": "bab.gate.rows.5-6", "note": "the row covers the rows above 4 on both gates"},
  {"match": "^panel:(tower|door)-.*-r[1-4]-", "part": "the front gate's relief rows 1 to 4", "piece": "bab.gate.rows.1-4"},
  {"match": "^panel:(tower|door)-.*-r[56]-", "part": "the front gate's relief rows 5 and 6", "piece": "bab.gate.rows.5-6"},
  {"match": "^life:palm-", "part": "the palms by the forecourt", "piece": "bab.palms"},
  {"match": "^life:bird-", "part": "the birds", "piece": "bab.life.birds"}
 ]
}
