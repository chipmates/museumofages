  {"match": "^map:house6$", "part": "House VI in Merkes, after Koldewey 1913", "piece": "bab.houses.merkes", "note": "its plan P2021 Fig. 6.15, its body guessed; a House VI row of its own is wanted"},
  {"match": "^map:house6-court-paving$", "part": "House VI's court paving at +5.2", "piece": "bab.houses.merkes", "note": "the lower paving's 40 cm bricks; the floor level at 570 BC between +5.0 and +6.4 a reading (P2021 p. 250)"},
